# JH.COMP Prospect — exemplo de configuração local
#
# Copie para .env e ajuste. O arquivo .env NÃO é versionado (RNF-006).
#   cp .env.example .env
#
# As portas abaixo foram escolhidas para não colidir com o PostgreSQL local
# (5432), com outros projetos desta máquina (5173, 8080, 55433) nem com as
# faixas de porta reservadas pelo Windows/Hyper-V (ver netsh excludedportrange).

# ---- PostgreSQL (docker compose) ----
POSTGRES_DB=jhcomp_prospect
POSTGRES_USER=jhcomp
# Credencial apenas de desenvolvimento local. Em produção, usar secret manager.
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_HOST_PORT=15432

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=local

# ---- Frontend ----
FRONTEND_PORT=5174
# Em container e com o proxy do Vite, a API fica na mesma origem, por isso o
# caminho e relativo. Sobrescreva apenas se rodar a API em outra origem.
VITE_API_BASE_URL=/api/v1

# ---- Porta da aplicacao em container (nginx do frontend) ----
APP_PORT=8090

# ---- Provedor de IA (sem efeito no MVP: só existe o provedor fake, D26) ----
# Nunca commitar valores reais. Enviar ao provedor apenas o necessário (doc 07 §7).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---- Fonte de empresas (RF-021, P1; apenas após validar termos de uso) ----
BUSINESS_SOURCE_PROVIDER=
BUSINESS_SOURCE_API_KEY=

# ---- Bootstrap local (perfil "local") ----
# Cria organizacao e administrador iniciais na primeira execucao.
# Sem senha definida, nada e criado. Nao usar em producao.
LOCAL_ADMIN_EMAIL=admin@jhcomp.local
LOCAL_ADMIN_PASSWORD=
LOCAL_ORGANIZATION_NAME=JH.COMP

# ---- Cookie de sessao ----
# Obrigatoriamente true em producao (HTTPS). Em local o frontend fala HTTP.
COOKIE_SECURE=false
