# JH.COMP Prospect — configuracao de PRODUCAO (VPS Linux, D27)
#
# No servidor:  cp .env.prod.example .env  &&  chmod 600 .env
# O arquivo .env NAO e versionado (RNF-006). Guarde uma copia da senha do banco
# fora do servidor: sem ela, um backup nao serve para restaurar.

# Faz "docker compose" usar o arquivo de producao sem precisar de -f.
COMPOSE_FILE=docker-compose.prod.yml

# ---- Dominio e TLS (Caddy) ----
# Precisa apontar (registro A/AAAA) para este servidor antes do primeiro start.
APP_DOMAIN=prospect.exemplo.com.br
# E-mail para avisos do Let's Encrypt (obrigatorio).
ACME_EMAIL=

# ---- PostgreSQL ----
POSTGRES_DB=jhcomp_prospect
POSTGRES_USER=jhcomp
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Analise de presenca digital (D24) ----
ANALYSIS_SERVED_STATES=MG
ANALYSIS_SERVED_SEGMENTS=

# ---- Backup (scripts/backup.sh) ----
BACKUP_DIR=/var/backups/jhcomp-prospect
BACKUP_RETENTION_DAYS=14

# ---- Monitoramento (scripts/healthcheck.sh) ----
# Opcional: URL que recebe um POST com o texto do alerta (ex.: webhook de chat).
ALERT_WEBHOOK_URL=
